{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://web-real-estate-backend.onrender.com/api/:path*" },
    { "source": "/login/oauth2/:path*", "destination": "https://web-real-estate-backend.onrender.com/login/oauth2/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
